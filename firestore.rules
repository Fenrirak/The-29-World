rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every request must carry a Firebase Auth token (anonymous sign-in
    // is enough — see firebase-init.js). This does NOT mean "only the
    // right user can touch their own doc": this app's login is a custom
    // username/password check done client-side against these documents
    // (see login() in data.js), not Firebase Auth, so rules here can't
    // key off *which* user is asking, only *whether someone with a
    // token* is asking. That's enough to stop unauthenticated scripts
    // and bots from reading or wiping the whole database, which is what
    // "if true" was exposing — it does not stop a signed-in visitor from
    // reading/writing any doc, including ones that aren't theirs.
    match /users/{username} {
      allow read, write: if request.auth != null;
    }
    match /classes/{classCode} {
      allow read, write: if request.auth != null;
    }
  }
}
